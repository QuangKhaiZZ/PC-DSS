{
  "info": {
    "_postman_id": "23c6d059-4e58-48a5-8e76-f74497fc9841",
    "name": "PC-DSS - CSV và tư vấn DSS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Chạy backend bằng launch-profile http rồi import collection. Không cần MySQL. Các request chỉ đọc dữ liệu và tính dự đoán/tư vấn, không sửa CSV. Sửa baseUrl nếu chạy cổng khác. Rendering giả định Windows 11; xem warnings và isExtrapolation trong kết quả. Chi tiết tại backend/README.md."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5170",
      "type": "string"
    }
  ],
